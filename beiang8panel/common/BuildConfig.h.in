/**
 * BuildConfig - 构建配置头文件
 *
 * 由CMake在构建时生成，包含编译时配置信息
 */

#ifndef BUILD_CONFIG_H
#define BUILD_CONFIG_H

// 版本信息
#define BEIANG_VERSION "@PROJECT_VERSION@"
#define BEIANG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define BEIANG_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define BEIANG_VERSION_PATCH @PROJECT_VERSION_PATCH@

// 构建类型
#define BEIANG_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

// HTTP服务器启用状态
#cmakedefine BEIANG_ENABLE_HTTP_SERVER

// 平台信息
#define BEIANG_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@"
#define BEIANG_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@"

// 交叉编译状态
#cmakedefine BEIANG_CROSS_COMPILING

// 本机(native)编译状态：BUILD_NATIVE=ON (x86_64 调试版)
#cmakedefine BEIANG_NATIVE_BUILD

// 编译器信息
#define BEIANG_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@"
#define BEIANG_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"

#endif // BUILD_CONFIG_H
